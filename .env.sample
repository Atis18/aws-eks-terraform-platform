# Local Docker Compose configuration. Copy to .env and fill in your Firebase web app settings.
# Enable Email/Password in Firebase Authentication and authorize localhost.
# These VITE_* settings are public client configuration, never an Admin SDK private key.
VITE_FB_apiKey=replace-with-your-firebase-web-api-key
VITE_FB_authDomain=your-firebase-project-id.firebaseapp.com
VITE_FB_projectId=your-firebase-project-id
VITE_FB_storageBucket=
VITE_FB_messagingSenderId=
VITE_FB_appId=replace-with-your-firebase-web-app-id

# Local development only. Never reuse this password in AWS.
POSTGRES_PASSWORD=localdevonly
